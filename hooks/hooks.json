{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/sabia.mjs\" sync --quiet",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/sabia-report-binding.mjs\"",
            "timeout": 8
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__(plugin_sabia-claude-code-otel_)?sabia-artifacts__report_artifact$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/sabia-report-binding.mjs\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "^mcp__.+__.+$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/sabia-connector-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
